  script.
    console.log('===== SCRIPT INITIATED =====');

    // Wait until DOM is fully loaded
    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOM fully loaded and parsed.');

      // Activity tracking
      const activityBadge = document.getElementById('activities-completion-badge');
      const activityCheckboxes = document.querySelectorAll('input[type="checkbox"]:not(.python-checkbox):not(.mdl-checkbox)');
      
      // Python course tracking
      const pythonBadge = document.getElementById('python-completion-badge');
      const pythonCheckboxes = document.querySelectorAll('.python-checkbox');
      
      // Math behind deep learning tracking
      const mdlBadge = document.getElementById('mdl-completion-badge');
      const mdlCheckboxes = document.querySelectorAll('.mdl-checkbox');
      
      // Overall progress elements
      const progressCircle = document.querySelector('.progress-circle');
      const progressNumber = document.querySelector('.progress-number');
      const progressBar = document.querySelector('.progress-bar');
      const progressText = document.querySelector('.small.text-muted.text-center');

      // Function to update activity progress
      function updateActivityProgress() {
        const total = activityCheckboxes.length;
        const completed = Array.from(activityCheckboxes).filter(cb => cb.checked).length;
        
        // Update the badge in card header
        if (activityBadge) {
          activityBadge.textContent = `${completed}/${total} Completed`;
        }
        
        return { completed, total };
      }

      // Function to update Python course progress
      function updatePythonProgress() {
        const total = pythonCheckboxes.length;
        const completed = Array.from(pythonCheckboxes).filter(cb => cb.checked).length;
        
        // Update the badge in card header
        if (pythonBadge) {
          pythonBadge.textContent = `${completed}/${total} Completed`;
        }
        
        // Update progress bars for week items
        Array.from(pythonCheckboxes).forEach(checkbox => {
          const progressBar = checkbox.closest('.list-group-item').querySelector('.progress-bar');
          
          if (progressBar) {
            // Calculate the percentage based on whether this week is checked
            const percent = checkbox.checked ? 100 : 0;
            progressBar.style.width = `${percent}%`;
            progressBar.setAttribute('aria-valuenow', percent);
          }
        });
        
        return { completed, total };
      }
      
      // Function to update Math Behind DL progress
      function updateMdlProgress() {
        const total = mdlCheckboxes.length;
        const completed = Array.from(mdlCheckboxes).filter(cb => cb.checked).length;
        
        // Update the badge in card header
        if (mdlBadge) {
          mdlBadge.textContent = `${completed}/${total} Completed`;
        }
        
        // Update progress bars for week items
        Array.from(mdlCheckboxes).forEach(checkbox => {
          const progressBar = checkbox.closest('.list-group-item').querySelector('.progress-bar');
          
          if (progressBar) {
            // Calculate the percentage based on whether this week is checked
            const percent = checkbox.checked ? 100 : 0;
            progressBar.style.width = `${percent}%`;
            progressBar.setAttribute('aria-valuenow', percent);
          }
        });
        
        return { completed, total };
      }

      // Function to calculate and update overall progress
      function updateOverallProgress() {
        const activities = updateActivityProgress();
        const python = updatePythonProgress();
        const mdl = updateMdlProgress();
        
        const totalItems = activities.total + python.total + mdl.total;
        const completedItems = activities.completed + python.completed + mdl.completed;
        const percent = Math.round((completedItems / totalItems) * 100);

        // Update the overall progress summary section
        if (progressNumber) {
          progressNumber.textContent = `${percent}%`;
        }
        
        if (progressCircle) {
          progressCircle.style.background = `conic-gradient(#4B9CD3 0% ${percent}%, #f3f3f3 ${percent}% 100%)`;
        }

        if (progressBar) {
          progressBar.style.width = `${percent}%`;
          progressBar.setAttribute('aria-valuenow', percent);
        }

        if (progressText) {
          progressText.textContent = `${completedItems} of ${totalItems} activities completed`;
        }

        console.log(`Overall progress updated: ${completedItems}/${totalItems} (${percent}%)`);
      }

      // Add event listeners to all activity checkboxes
      activityCheckboxes.forEach(cb => {
        cb.addEventListener('change', updateOverallProgress);
      });

      // Add event listeners to all Python checkboxes
      pythonCheckboxes.forEach(cb => {
        cb.addEventListener('change', updateOverallProgress);
      });
      
      // Add event listeners to all MDL checkboxes
      mdlCheckboxes.forEach(cb => {
        cb.addEventListener('change', updateOverallProgress);
      });

      // Initialize progress on page load
      updateOverallProgress();
    });





