extends layout

block content
  // Hero section with user welcome and background
  .hero-section.py-5(style="background-color: #13294B; min-height: 220px;")
    .container
      .row
        .col-md-8
          .welcome-card.p-4
            h1.display-4.text-white Welcome back, 
              span.fw-bold #{user.username}.

  .container.py-4
    // Continue where you left off section
    .row.mb-4
      .col-12
        h2.border-bottom.pb-2(style="color: #13294B;") Continue Where You Left Off
        
    .row.mb-4
      // Python Course Card
      .col-md-6.col-lg-4.mb-3
        .card.h-100.shadow-sm
          .card-header.text-white.d-flex.justify-content-between.align-items-center(style="background-color: #4B9CD3;")
            h5.mb-0 Python
            span.badge.bg-white.text-primary 2/5 Completed
          .card-body
            p.card-text Last worked on: Week 2 - Data Types and Variables
            .progress.mb-3(style="height: 8px;")
              .progress-bar(role="progressbar" style="width: 40%; background-color: #4B9CD3;" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100")
            a.btn.btn-outline-primary.btn-sm(href='/resources' style="color: #4B9CD3; border-color: #4B9CD3;")
              i.fas.fa-arrow-right.me-1
              | Continue Learning
      
      // Math Behind Deep Learning Card
      .col-md-6.col-lg-4.mb-3
        .card.h-100.shadow-sm
          .card-header.text-white.d-flex.justify-content-between.align-items-center(style="background-color: #4B9CD3;")
            h5.mb-0 Math Behind Deep Learning
            span.badge.bg-white.text-primary 1/2 Completed
          .card-body
            p.card-text Last worked on: Week 1 - Intro to Linear Algebra
            .progress.mb-3(style="height: 8px;")
              .progress-bar(role="progressbar" style="width: 50%; background-color: #4B9CD3;" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100")
            a.btn.btn-outline-primary.btn-sm(href='/resources' style="color: #4B9CD3; border-color: #4B9CD3;")
              i.fas.fa-arrow-right.me-1
              | Continue Learning
      
      // LSTM Activity Card
      .col-md-6.col-lg-4.mb-3
        .card.h-100.shadow-sm
          .card-header.text-white.d-flex.justify-content-between.align-items-center(style="background-color: #13294B;")
            h5.mb-0 LSTM Interactive Activity
            span.badge.bg-white.text-dark In Progress
          .card-body
            p.card-text Learn about Long Short-Term Memory Networks
            .progress.mb-3(style="height: 8px;")
              .progress-bar(role="progressbar" style="width: 25%; background-color: #13294B;" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100")
            a.btn.btn-outline-dark.btn-sm(href='/resources' style="color: #13294B; border-color: #13294B;")
              i.fas.fa-arrow-right.me-1
              | Continue Activity

    // Middle section with two columns
    .row.mb-4
      // Left column - Calendar/Events
      .col-lg-6.mb-4.mb-lg-0
        .card.shadow-sm
          .card-header.text-white(style="background-color: #13294B;")
            h4.mb-0 Upcoming Events
          .card-body
            .upcoming-event.mb-3
              .d-flex.justify-content-between.align-items-center.mb-2
                h5.mb-0(style="color: #13294B;") Today: SAILea Speaker Event
                span.badge.text-white(style="background-color: #4B9CD3;") Today
              p.text-muted Learn about the latest in AI from industry experts
              a.btn.btn-sm.btn-outline-primary(href='#' style="color: #4B9CD3; border-color: #4B9CD3;") View Details

            .upcoming-event
              .d-flex.justify-content-between.align-items-center.mb-2
                h5.mb-0(style="color: #13294B;") January 24: Club Meeting
                span.badge.text-white(style="background-color: #13294B;") 3 days
              p.text-muted Weekly discussion on current AI/CS topics
              a.btn.btn-sm.btn-outline-dark(href='#' style="color: #13294B; border-color: #13294B;") View Details
              
            .text-center.mt-3
              a.btn.text-white(href='/calendar' style="background-color: #4B9CD3;") View Full Calendar

      // Right column - Progress summary with simple circle
      .col-lg-6
        .card.shadow-sm
          .card-header.text-white(style="background-color: #13294B;")
            h4.mb-0 Your Progress
          .card-body.p-4
            .row.align-items-center
              .col-md-6.mb-4.mb-md-0
                .progress-circle.mx-auto.position-relative(style="width: 160px; height: 160px;")
                  // Very simple progress indicator - just two circles
                  svg(width="160" height="160" viewBox="0 0 160 160")
                    // Gray background circle
                    circle(cx="80" cy="80" r="70" fill="none" stroke="#e6e6e6" stroke-width="16")
                    
                    // Single Carolina Blue progress arc (30% of the circle)
                    circle(cx="80" cy="80" r="70" fill="none" stroke="#4B9CD3" stroke-width="16" 
                      stroke-dasharray="440" stroke-dashoffset="308" transform="rotate(-90 80 80)")
                  
                  // Percentage text in the middle  
                  .progress-circle-text.position-absolute.top-50.start-50.translate-middle.text-center
                    h2.mb-0.fw-bold 30%

              .col-md-6.text-start
                h3.mb-4(style="color: #13294B;") Keep going!
                ul.list-unstyled.fs-5
                  li.mb-3
                    span(style="color: #4B9CD3;")
                      i.fas.fa-check-circle.me-2
                      | 3 activities completed
                  li.mb-3
                    span(style="color: #13294B;")
                      i.fas.fa-hourglass-half.me-2
                      | 7 activities in progress
                  li
                    span(style="color: #4B9CD3;")
                      i.fas.fa-star.me-2
                      | Level: Beginner

    // Resources and Materials
    .row
      .col-12
        h2.border-bottom.pb-2(style="color: #13294B;") Recent Materials
        
    .row
      .col-md-4.mb-3
        .card.h-100.shadow-sm
          .card-img-top.text-center.py-4(style="background-color: #f8f9fa;")
            i.fas.fa-calculator.fa-5x(style="color: #4B9CD3;")
          .card-body
            h5.card-title(style="color: #13294B;") Mathematics behind Deep Learning Lesson 1
            p.card-text Fundamental mathematics concepts needed for deep learning algorithms
            a.btn.btn-outline-primary.btn-sm(href='/resources' style="color: #4B9CD3; border-color: #4B9CD3;") View Material
      
      .col-md-4.mb-3
        .card.h-100.shadow-sm
          .card-img-top.text-center.py-4(style="background-color: #f8f9fa;")
            i.fab.fa-java.fa-5x(style="color: #4B9CD3;")
          .card-body
            h5.card-title(style="color: #13294B;") Java Lesson 3
            p.card-text Week 3 Loops and If Arrays in Java programming
            a.btn.btn-outline-primary.btn-sm(href='/resources' style="color: #4B9CD3; border-color: #4B9CD3;") View Material
      
      .col-md-4.mb-3
        .card.h-100.shadow-sm
          .card-img-top.text-center.py-4(style="background-color: #f8f9fa;")
            i.fas.fa-robot.fa-5x(style="color: #4B9CD3;")
          .card-body
            h5.card-title(style="color: #13294B;") How to use the ChatGPT API
            p.card-text Learn to integrate and use the ChatGPT API in your applications
            a.btn.btn-outline-primary.btn-sm(href='/resources' style="color: #4B9CD3; border-color: #4B9CD3;") View Material

  // Add CSS for the progress circle animation and card styling
  style.
    :root {
      --unc-blue: #4B9CD3;
      --unc-navy: #13294B;
    }
    
    /* Simple progress circle animation */
    @keyframes simpleProgress {
      0% { stroke-dashoffset: 440; }
      100% { stroke-dashoffset: 308; }
    }
    
    .progress-circle svg circle:nth-of-type(2) {
      animation: simpleProgress 1.5s ease-out forwards;
    }
    
    .card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: none;
    }
    
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    
    .hero-section {
      display: flex;
      align-items: center;
    }
    
    .btn-outline-primary {
      color: var(--unc-blue);
      border-color: var(--unc-blue);
    }
    
    .btn-outline-primary:hover {
      background-color: var(--unc-blue);
      color: white;
    }
    
    .btn-outline-dark {
      color: var(--unc-navy);
      border-color: var(--unc-navy);
    }
    
    .btn-outline-dark:hover {
      background-color: var(--unc-navy);
      color: white;
    }
    
    .text-primary {
      color: var(--unc-blue) !important;
    }
    
    .bg-primary {
      background-color: var(--unc-blue) !important;
    }