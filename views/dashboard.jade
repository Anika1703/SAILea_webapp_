      --unc-blue: #4B9CD3;
      --unc-navy: #13294B;
    }
    
    /* Simple progress circle animation */
    @keyframes simpleProgress {
      0% { stroke-dashoffset: 440; }
      100% { stroke-dashoffset: 308; }
    }
    
    .progress-circle svg circle:nth-of-type(2) {
      animation: simpleProgress 1.5s ease-out forwards;
    }
    
    .card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: none;
    }
    
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    
    .hero-section {
      display: flex;
      align-items: center;
    }
    
    .btn-outline-primary {
      color: var(--unc-blue);
      border-color: var(--unc-blue);
    }
    
    .btn-outline-primary:hover {
      background-color: var(--unc-blue);
      color: white;
    }
    
    .btn-outline-dark {
      color: var(--unc-navy);
      border-color: var(--unc-navy);
    }
    
    .btn-outline-dark:hover {
      background-color: var(--unc-navy);
      color: white;
    }
    
    .text-primary {
      color: var(--unc-blue) !important;
    }
    
    .bg-primary {
      background-color: var(--unc-blue) !important;
    }